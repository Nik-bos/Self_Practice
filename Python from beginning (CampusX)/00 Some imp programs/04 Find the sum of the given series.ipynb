   ],
   "source": [
    "# Program to find the sum of given series till nth term.\n",
    "# Series 1/1! + 2/2! + 3/3! + 4/4!...\n",
    "\n",
    "n = int(input(\"Enter the nth term: \"))\n",
    "\n",
    "fact = 1\n",
    "sum = 0\n",
    "\n",
    "for i in range(1, n+1):\n",
    "    \n",
    "    fact = fact * i\n",
    "    sum = sum + i/fact\n",
    "\n",
    "print(sum)"
   ]
  },

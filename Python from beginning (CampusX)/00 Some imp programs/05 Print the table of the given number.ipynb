   "source": [
    "# Program to print the table of the given number\n",
    "\n",
    "num = int(input(\"Enter the number: \"))\n",
    "i = 1\n",
    "\n",
    "while i < 11:\n",
    "    print(f'{num} * {i} =', num * i)\n",
    "    i = i + 1\n"
   ]
